# ==========================================================
# Rockyca v2 Production Environment (place on EC2 as .env.prod)
# NEVER commit .env.prod to Git!
# ==========================================================

# Docker Images (replace <github-username> and <repo-name> in lowercase)
API_IMAGE=ghcr.io/<github-username>/<repo-name>-api:latest
WEB_IMAGE=ghcr.io/<github-username>/<repo-name>-web:latest

# PostgreSQL (inside Docker network; host is "postgres")
POSTGRES_USER=rockyca
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=rockyca
DATABASE_URL="postgresql://rockyca:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/rockyca?schema=public"

# NestJS API Server
NODE_ENV=production
PORT=4000
CORS_ORIGIN="https://rockyca.com,https://www.rockyca.com"

# JWT Auth (generate with: openssl rand -hex 32)
JWT_SECRET="CHANGE_ME_64_CHAR_RANDOM_HEX_SECRET"
JWT_EXPIRES_IN="7d"
COOKIE_SECURE=true

# Initial Admin Seed (run once via: docker compose -f docker-compose.prod.yml exec api npm run prisma:seed --workspace=apps/api)
ADMIN_SEED_EMAIL="admin@rockyca.com"
ADMIN_SEED_PASSWORD="CHANGE_ME_STRONG_ADMIN_PASSWORD"
ADMIN_SEED_NAME="Rocky Admin"

# AWS S3 + CloudFront (leave AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY empty to use EC2 IAM Role!)
# IMPORTANT: On EC2 Instance Settings -> Metadata options -> set Hop limit = 2 so Docker containers can use EC2 IAM Role.
AWS_REGION="ca-central-1"
AWS_S3_BUCKET="rockyca-665441653999-ca-central-1-an"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL="https://d2ai6dt82uyfyr.cloudfront.net"

# SMTP Mail (Use a freshly rotated Gmail App Password or business SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-fresh-app-password"
CONTACT_FROM_EMAIL="your-email@gmail.com"
CONTACT_RECIPIENT_EMAIL="sales@rockyca.com"

# Cloudflare Turnstile (Real production Secret Key)
TURNSTILE_SECRET_KEY="your-cloudflare-turnstile-secret-key"
TURNSTILE_BYPASS=false
