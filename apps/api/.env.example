# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL from docker-compose.yml)
DATABASE_URL="postgresql://rockyca:rockyca_dev_password@localhost:5432/rockyca?schema=public"

# JWT Auth
JWT_SECRET="rockyca-local-dev-secret-change-in-production-64chars-minimum"
JWT_EXPIRES_IN="7d"
COOKIE_SECURE=false

# Initial Admin Seed
ADMIN_SEED_EMAIL="admin@rockyca.com"
ADMIN_SEED_PASSWORD="ChangeMe123!"
ADMIN_SEED_NAME="Rocky Admin"

# ==========================================================
# S3 Storage — Local Docker MinIO (Default for local testing)
# Console: http://localhost:9001 (minioadmin / minioadmin_password)
# ==========================================================
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin_password"
AWS_S3_BUCKET="rockyca-inventory-media"
S3_ENDPOINT="http://localhost:9000"
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL="http://localhost:9000/rockyca-inventory-media"

# --- Production AWS S3 (uncomment and replace the block above when deploying) ---
# AWS_REGION="ca-central-1"
# AWS_ACCESS_KEY_ID="your-aws-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
# AWS_S3_BUCKET="rockyca-inventory-media"
# S3_ENDPOINT=""
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL="" # Optional CloudFront URL e.g. https://cdn.rockyca.com

# Cloudflare Turnstile (Cloudflare official always-pass test secret for local dev)
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# Set true if testing completely offline without internet access
TURNSTILE_BYPASS=false
