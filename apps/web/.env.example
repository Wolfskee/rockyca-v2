# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Internal SSR URL (optional, defaults to NEXT_PUBLIC_API_URL)
INTERNAL_API_URL=http://localhost:4000/api

# Cloudflare Turnstile Site Key (default below is Cloudflare's official always-pass test sitekey for local dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional: Extra image hostname for next/image if using CloudFront or custom S3 domain
NEXT_PUBLIC_MEDIA_HOSTNAME=
